# Qloo. This project's key is a production key and only works on api.qloo.com.
# A hackathon key needs https://hackathon.api.qloo.com instead. The hosts are not interchangeable.
QLOO_API_KEY=
QLOO_API_BASE=https://api.qloo.com

# Planner, explanations, and refinement. Structured outputs, not free-form guesses.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional live lookup for events and places. Without it, those ideas stay labeled as ideas.
# https://serper.dev
SERPER_API_KEY=

# Cartoon illustrations on finding cards. Replicate model openai/gpt-image-2.
# Without it, cards still show a placeholder. Links on cards are search links, not invented store pages.
REPLICATE_API_TOKEN=

# Optional. Without these, profiles stay in the browser and sign-in is hidden.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
